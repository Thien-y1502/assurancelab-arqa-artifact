{
  "candidate": "ARQA",
  "version": "2026-11-03-pre-registered-v1",
  "research_question": "Can a fault-domain-aware quorum decision prevent false PASS under correlated source compromise while retaining positive-case availability?",
  "primary_metrics": [
    "false_pass_rate_in_model",
    "true_pass_coverage",
    "out_of_model_abstention"
  ],
  "secondary_metrics": ["conflict_rate", "unknown_rate", "signature_validation_rate", "decision_latency_units"],
  "seeds": [101, 211, 307, 401, 503],
