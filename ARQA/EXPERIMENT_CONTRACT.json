  "topology": {"domains": 5, "sources_per_domain": 3, "declared_max_compromised_domains": 1, "quorum_domains": 3},
  "baselines": ["source_majority", "naive_q3", "domain_majority", "dempster_like"],
  "falsifiers": [
    "arqa_false_pass_rate_in_model_above_zero",
    "arqa_true_pass_coverage_below_0.70",
    "arqa_passes_when_support_is_from_fewer_than_three_domains",
    "signature_failure_is_treated_as_truth"
  ],
  "success_rule": {
    "false_pass_rate_in_model": "0.0",
    "true_pass_coverage": ">= 0.70",
    "out_of_model_abstention": ">= 0.95"
  },
  "docker": "required_for_multi-process_reproduction_but_unavailable_at_execution_time",
  "enterprise_claim": "NOT_TESTED"
}
